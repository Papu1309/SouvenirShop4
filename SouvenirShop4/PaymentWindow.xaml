<Window x:Class="SouvenirShop.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа" Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Оформление заказа" FontSize="18" FontWeight="Bold"
                  HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Прокручиваемая область для основного содержимого -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Список товаров -->
                <DataGrid Name="dgOrderItems" AutoGenerateColumns="False" IsReadOnly="True"
                          Height="200" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding Souvenir.Name}" Width="200"/>
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="80"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat={}{0:C}}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Name="txtTotal" FontSize="14" FontWeight="Bold" 
                          Margin="0,10,0,10" HorizontalAlignment="Right"/>

                <!-- Способ оплаты -->
                <GroupBox Header="Способ оплаты" Margin="0,10,0,10">
                    <StackPanel>
                        <RadioButton Name="rbCash" Content="Наличные" IsChecked="True" 
                                    Checked="PaymentMethod_Changed" Margin="5"/>
                        <RadioButton Name="rbCard" Content="Банковская карта" 
                                    Checked="PaymentMethod_Changed" Margin="5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Панель для данных карты (по умолчанию скрыта) -->
                <Border Name="cardPanel" Visibility="Collapsed" 
                        BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" 
                        Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Данные банковской карты" FontWeight="Bold" 
                                  FontSize="14" Margin="0,0,0,10"/>

                        <!-- Номер карты -->
                        <TextBlock Text="Номер карты:" Margin="0,5,0,0"/>
                        <TextBox Name="txtCardNumber" MaxLength="19" 
                                 TextChanged="CardNumber_TextChanged" Margin="0,5,0,10"
                                 Padding="5" PreviewTextInput="NumberValidationTextBox"/>
                        <TextBlock Name="lblCardNumberError" Foreground="Red" FontSize="10" 
                                   Visibility="Collapsed" Margin="0,-5,0,5"/>

                        <!-- Имя владельца -->
                        <TextBlock Text="Имя владельца (как на карте):" Margin="0,5,0,0"/>
                        <TextBox Name="txtCardHolder" Margin="0,5,0,10" Padding="5"
                                 TextChanged="CardHolder_TextChanged"
                                 PreviewTextInput="CardHolderValidationTextBox"/>
                        <TextBlock Name="lblCardHolderError" Foreground="Red" FontSize="10" 
                                   Visibility="Collapsed" Margin="0,-5,0,5"/>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Срок действия -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Срок действия (MM/YY):"/>
                                <TextBox Name="txtExpiry" MaxLength="5" 
                                         TextChanged="Expiry_TextChanged" Padding="5"
                                         PreviewTextInput="NumberValidationTextBox"/>
                                <TextBlock Name="lblExpiryError" Foreground="Red" FontSize="10" 
                                           Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- CVV -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CVV:"/>
                                <TextBox Name="txtCVV" MaxLength="3" 
                                         TextChanged="CVV_TextChanged" Padding="5"
                                         PreviewTextInput="NumberValidationTextBox"/>
                                <TextBlock Name="lblCVVError" Foreground="Red" FontSize="10" 
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Отмена" Click="CancelButton_Click" 
                            Width="100" Height="30" Margin="0,0,10,0"/>
                    <Button Content="Подтвердить заказ" Click="ConfirmButton_Click" 
                            Width="140" Height="30" Background="#FF0080FF" Foreground="White"
                            Name="btnConfirm"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>